any where ((registry.path:"*\\System\\CurrentControlSet\\Services\\*" and registry.path:"*\\ImagePath") and (registry.data.strings like~ ("*\\Users\\*", "*\\AppData\\*", "*\\Windows\\Temp\\*", "*\\ProgramData\\*", "*powershell*", "*cmd.exe*", "*rundll32*"))) and (not registry.data.strings:"*\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*")
