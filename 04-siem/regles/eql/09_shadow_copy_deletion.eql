any where ((process.executable.caseless:"*\\vssadmin.exe" or process.pe.original_file_name:"VSSADMIN.EXE") and (process.command_line:"*delete*" and process.command_line:"*shadows*")) or (process.executable.caseless:"*\\wmic.exe" and (process.command_line:"*shadowcopy*" and process.command_line:"*delete*")) or (process.executable.caseless:"*\\bcdedit.exe" and (process.command_line like~ ("*recoveryenabled no*", "*ignoreallfailures*"))) or (process.executable.caseless:"*\\wbadmin.exe" and (process.command_line:"*delete*" and process.command_line:"*catalog*")) or (((process.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll"))) and process.command_line:"*Win32_ShadowCopy*" and (process.command_line like~ ("*Delete*", "*Remove-WmiObject*", "*Remove-CimInstance*")))
