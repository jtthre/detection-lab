any where (network.direction:"egress" and (process.executable.caseless like~ ("*\\mshta.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\regsvr32.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\installutil.exe"))) and (not (cidrMatch(destination.ip, "10.0.0.0/8") or cidrMatch(destination.ip, "172.16.0.0/12") or cidrMatch(destination.ip, "192.168.0.0/16") or cidrMatch(destination.ip, "127.0.0.0/8")))
