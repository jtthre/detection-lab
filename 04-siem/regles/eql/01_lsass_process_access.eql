any where (winlog.event_data.TargetImage:"*\\lsass.exe" and (winlog.event_data.GrantedAccess like~ ("*0x1010*", "*0x1410*", "*0x1438*", "*0x143a*", "*0x1fffff*"))) and (not ((process.executable.caseless like~ ("C:\\Windows\\System32\\csrss.exe", "C:\\Windows\\System32\\wininit.exe", "C:\\Windows\\System32\\svchost.exe", "C:\\Windows\\System32\\taskmgr.exe", "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe")) or (process.executable.caseless:"C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and process.executable.caseless:"*\\MsMpEng.exe")))
